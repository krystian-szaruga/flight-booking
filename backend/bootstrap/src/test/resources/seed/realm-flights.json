{
  "realm": "flights",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "feed-ingest-client",
      "enabled": true,
      "publicClient": false,
      "secret": "feed-ingest-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["feed:ingest"],
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "flight-booking-api",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "no-scope-client",
      "enabled": true,
      "publicClient": false,
      "secret": "no-scope-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "flight-booking-api",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "wrong-audience-client",
      "enabled": true,
      "publicClient": false,
      "secret": "wrong-audience-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["feed:ingest"]
    }
  ],
  "clientScopes": [
    {
      "name": "feed:ingest",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "defaultDefaultClientScopes": ["web-origins", "role_list", "roles", "profile", "email"]
}
